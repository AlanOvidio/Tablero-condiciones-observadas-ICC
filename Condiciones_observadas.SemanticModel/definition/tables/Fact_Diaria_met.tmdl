table Fact_Diaria_met
	lineageTag: be02eabf-b17d-46d7-9402-3b2954a1cbec

	refreshPolicy
		policyType: basic
		rollingWindowGranularity: year
		rollingWindowPeriods: 19
		incrementalGranularity: day
		incrementalPeriods: 7
		sourceExpression =
			let
			    Fuente = TablaEstaciones_met,
			    EjecutarAPI = Table.AddColumn(Fuente, "Lecturas", each fxLecturasEstacion_met_diario([estacionid], RangeStart, RangeEnd)),
			    ExpandirLista = Table.ExpandListColumn(EjecutarAPI, "Lecturas"),
			    QuitarVacias = Table.SelectRows(ExpandirLista, each [Lecturas] <> null),
			    ExpandirCampos = Table.ExpandRecordColumn(QuitarVacias, "Lecturas",
			        {"dia", "tempavg", "tempmin", "tempmax", "radiaciontotal", "humedadavg", "humedadmin", "humedadmax",
			         "vientoavg", "lluviasum", "etosum", "indicecaloravg", "indicecalormax"},
			        {"Fecha", "Temp_Media", "Temp_Min", "Temp_Max", "Rad_Total", "HR_Media", "HR_Min", "HR_Max",
			         "Viento_Media", "Precip_Total", "ETO_Total", "IC_Media", "IC_Max"}),
			    // ETo puede llegar como texto vacío: se deja nulo (no 0)
			    EtoTexto = Table.TransformColumnTypes(ExpandirCampos, {{"ETO_Total", type text}}),
			    EtoVacio = Table.ReplaceValue(EtoTexto, "", null, Replacer.ReplaceValue, {"ETO_Total"}),
			    Tipos = Table.TransformColumnTypes(EtoVacio, {
			        {"estacionid", Int64.Type}, {"Fecha", type date},
			        {"Temp_Media", type number}, {"Temp_Min", type number}, {"Temp_Max", type number},
			        {"Rad_Total", type number}, {"HR_Media", type number}, {"HR_Min", type number}, {"HR_Max", type number},
			        {"Viento_Media", type number}, {"Precip_Total", type number}, {"ETO_Total", type number},
			        {"IC_Media", type number}, {"IC_Max", type number}
			    }),
			    // Filtro de actualización incremental
			    Incremental = Table.SelectRows(Tipos, each
			        [Fecha] >= Date.From(List.Max({RangeStart, #datetime(2008, 1, 1, 0, 0, 0)})) and
			        [Fecha] < Date.From(RangeEnd)),
			    Anio = Table.AddColumn(Incremental, "Anio", each Date.Year([Fecha]), Int64.Type),
			    Mes = Table.AddColumn(Anio, "Mes", each Date.Month([Fecha]), Int64.Type),
			    // Energía diaria (MJ/m²) = Σ lecturas de 15 min (W/m²) × 900 s / 10⁶
			    RadMJ = Table.AddColumn(Mes, "Rad_MJ", each [Rad_Total] * 900 / 1000000, type number),
			    // Irradiancia diurna media (W/m²): Σ lecturas / 52 lecturas de 06:00 a 18:59 (ventana fija, igual que los scripts R)
			    Irradiancia = Table.AddColumn(RadMJ, "Irradiancia_Diurna", each [Rad_Total] / 52, type number),
			    Amplitud = Table.AddColumn(Irradiancia, "Amplitud_Termica", each [Temp_Max] - [Temp_Min], type number),
			    // Balance hídrico diario: nulo si falta la ETo
			    Balance = Table.AddColumn(Amplitud, "Balance_Hidrico", each [Precip_Total] - [ETO_Total], type number)
			in
			    Balance

	column estacionid
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 41ce0fa6-5689-4236-9133-cfa28bae909b
		summarizeBy: none
		sourceColumn: estacionid

		annotation SummarizationSetBy = Automatic

