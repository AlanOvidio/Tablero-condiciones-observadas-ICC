	partition Fact_Mensual_met = calculated
		mode: import
		source =
				VAR _Ult = MAX ( Fact_Diaria_met[Fecha] )
				VAR _Base =
				    ADDCOLUMNS (
				        SUMMARIZE ( Fact_Diaria_met, Fact_Diaria_met[estacionid], Fact_Diaria_met[Anio], Fact_Diaria_met[Mes] ),
				        "Fecha_Mes", DATE ( Fact_Diaria_met[Anio], Fact_Diaria_met[Mes], 1 ),
				        "Dias_Mes", DAY ( EOMONTH ( DATE ( Fact_Diaria_met[Anio], Fact_Diaria_met[Mes], 1 ), 0 ) ),
				        "N_Dias", CALCULATE ( COUNTROWS ( Fact_Diaria_met ) ),
				        "Precip", CALCULATE ( SUM ( Fact_Diaria_met[Precip_Total] ) ),
				        "ETo", CALCULATE ( SUM ( Fact_Diaria_met[ETO_Total] ) ),
				        "N_Dias_ETo", CALCULATE ( COUNT ( Fact_Diaria_met[ETO_Total] ) ),
				        "Rad_MJ", CALCULATE ( SUM ( Fact_Diaria_met[Rad_MJ] ) ),
				        "Irradiancia", CALCULATE ( AVERAGE ( Fact_Diaria_met[Irradiancia_Diurna] ) ),
				        "Temp_Media", CALCULATE ( AVERAGE ( Fact_Diaria_met[Temp_Media] ) ),
				        "Temp_Max_Abs", CALCULATE ( MAX ( Fact_Diaria_met[Temp_Max] ) ),
				        "Temp_Min_Abs", CALCULATE ( MIN ( Fact_Diaria_met[Temp_Min] ) ),
				        "Amplitud", CALCULATE ( AVERAGE ( Fact_Diaria_met[Amplitud_Termica] ) ),
				        "HR_Media", CALCULATE ( AVERAGE ( Fact_Diaria_met[HR_Media] ) ),
				        "Viento_Media", CALCULATE ( AVERAGE ( Fact_Diaria_met[Viento_Media] ) ),
				        "IC_Max", CALCULATE ( MAX ( Fact_Diaria_met[IC_Max] ) )
				    )
				RETURN
				    ADDCOLUMNS (
				        _Base,
				        "BH", IF ( [N_Dias_ETo] > 0, [Precip] - [ETo] ),
				        "Completitud", DIVIDE ( [N_Dias], [Dias_Mes] ),
				        "Mes_Completo", EOMONTH ( [Fecha_Mes], 0 ) <= _Ult,
				        "Mes_Valido", EOMONTH ( [Fecha_Mes], 0 ) <= _Ult && DIVIDE ( [N_Dias], [Dias_Mes] ) >= 0.8
				    )

