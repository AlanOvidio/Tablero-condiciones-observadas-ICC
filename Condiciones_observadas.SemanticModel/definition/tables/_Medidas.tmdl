	measure Ultima_Fecha = CALCULATE ( MAX ( Fact_Diaria_met[Fecha] ), REMOVEFILTERS () )
		formatString: dd/mm/yyyy
		displayFolder: 0 Contexto
		lineageTag: 888759df-d499-489e-921e-cad0f5b45439

	/// Último mes cerrado (AAAAMM)
	measure Ultimo_Mes_Completo =
			CALCULATE (
			    MAXX ( FILTER ( Fact_Mensual_met, Fact_Mensual_met[Mes_Completo] ), Fact_Mensual_met[Anio] * 100 + Fact_Mensual_met[Mes] ),
			    REMOVEFILTERS ()
			)
		formatString: 0
		displayFolder: 0 Contexto
		lineageTag: b43d35f7-2412-4d18-b074-f5f76cc09b1c

	/// Año del segmentador Año de análisis; sin selección, el año del último dato
	measure Anio_Analisis = SELECTEDVALUE ( Anio_Sel[Año], YEAR ( [Ultima_Fecha] ) )
		formatString: 0
		displayFolder: 0 Contexto
		lineageTag: 60fdfe76-2a8f-4343-ae4a-6481799f8c40

	/// Inicio del periodo histórico (segmentador)
	measure Base_Ini = MIN ( Anios_Base[Año] )
		formatString: 0
		displayFolder: 0 Contexto
		lineageTag: 3f06c8c0-99f8-411c-8c1d-81422347afac

	/// Fin del periodo histórico; nunca incluye el año de análisis
	measure Base_Fin = MIN ( MAX ( Anios_Base[Año] ), [Anio_Analisis] - 1 )
		formatString: 0
		displayFolder: 0 Contexto
		lineageTag: 900b4760-464e-43a8-9607-1f45f6fa070a

	/// Estaciones de la selección que tienen datos
	/// Estaciones que aportan dato de la variable seleccionada en el año de análisis (completitud por variable)
	measure N_Estaciones =
			VAR _y = [Anio_Analisis]
			VAR _multi = COUNTROWS ( FILTER ( VALUES ( Estaciones_met[estacionid] ), ( ISFILTERED ( Estaciones_met[Estación] ) || COUNTROWS ( VALUES ( Estaciones_met[estacionid] ) ) <= 1 || CALCULATE ( MAX ( Estaciones_met[Excluir_Agregados] ) ) = 0 ) && NOT ( ISFILTERED ( Estaciones_met[Estación] ) && COUNTROWS ( VALUES ( Estaciones_met[Tipo] ) ) > 1 ) ) ) > 1
			VAR _sinElig = [_Sin_Elegibles]
			RETURN
			    COUNTROWS (
			        FILTER ( FILTER ( VALUES ( Estaciones_met[estacionid] ), ( ISFILTERED ( Estaciones_met[Estación] ) || COUNTROWS ( VALUES ( Estaciones_met[estacionid] ) ) <= 1 || CALCULATE ( MAX ( Estaciones_met[Excluir_Agregados] ) ) = 0 ) && NOT ( ISFILTERED ( Estaciones_met[Estación] ) && COUNTROWS ( VALUES ( Estaciones_met[Tipo] ) ) > 1 ) ), NOT ISBLANK ( CALCULATE ( [_Mes_Est], Fact_Mensual_met[Anio] = _y ) ) && ( NOT _multi || _sinElig || [_Anios_Base_Est] >= [Min_Anios_Base] ) )
			    ) + 0
		formatString: 0
		displayFolder: 0 Contexto
		lineageTag: 382daf49-0224-4c44-9d2b-262589fe76d6

	/// Valor de UNA estación en el periodo del contexto
	measure _Dia_Est =
			VAR v = [Var_Sel]
			RETURN
			    SWITCH (
			        v,
			        "PCP", SUM ( Fact_Diaria_met[Precip_Total] ),
			        "ETO", SUM ( Fact_Diaria_met[ETO_Total] ),
			        "ETOD", AVERAGE ( Fact_Diaria_met[ETO_Total] ),
			        "BH", SUM ( Fact_Diaria_met[Balance_Hidrico] ),
			        "RAD", SUM ( Fact_Diaria_met[Rad_MJ] ),
			        "IRR", AVERAGE ( Fact_Diaria_met[Irradiancia_Diurna] ),
			        "TMED", AVERAGE ( Fact_Diaria_met[Temp_Media] ),
			        "TMAX", MAX ( Fact_Diaria_met[Temp_Max] ),
			        "TMIN", MIN ( Fact_Diaria_met[Temp_Min] ),
			        "ICMED", AVERAGE ( Fact_Diaria_met[IC_Media] ),
			        "IC", MAX ( Fact_Diaria_met[IC_Max] ),
			        "ICMIN", MIN ( Fact_Diaria_met[IC_Min] )
			    )
		isHidden
		displayFolder: 1 Diario
		lineageTag: be112d42-2776-49da-a1bc-67d17ac1f416

	/// Suma (o promedio/extremo) por estación y luego promedio de las estaciones con dato
	measure Valor_Diario = AVERAGEX ( FILTER ( VALUES ( Estaciones_met[estacionid] ), ( ISFILTERED ( Estaciones_met[Estación] ) || COUNTROWS ( VALUES ( Estaciones_met[estacionid] ) ) <= 1 || CALCULATE ( MAX ( Estaciones_met[Excluir_Agregados] ) ) = 0 ) && NOT ( ISFILTERED ( Estaciones_met[Estación] ) && COUNTROWS ( VALUES ( Estaciones_met[Tipo] ) ) > 1 ) ), [_Dia_Est] )
		formatString: 0.0
		displayFolder: 1 Diario
		lineageTag: e84e5096-65f5-4164-8a64-061bf669cd82

	/// Precipitación en el año de análisis (eje de pentadas)
	measure PCP_Anio = VAR _y = [Anio_Analisis] RETURN CALCULATE ( [Valor_Diario], Variables[Clave] = "PCP", Calendario[Anio] = _y )
		formatString: 0.0
		displayFolder: 1 Diario
		lineageTag: 290edbe5-c847-45d7-82cf-ed3cc27726c5

	/// ETo en el año de análisis (eje de pentadas)
	measure ETO_Anio = VAR _y = [Anio_Analisis] RETURN CALCULATE ( [Valor_Diario], Variables[Clave] = "ETO", Calendario[Anio] = _y )
		formatString: 0.0
		displayFolder: 1 Diario
		lineageTag: 5dbcce68-99ed-4777-b1e3-75b9c92f828b

	/// Balance en el año de análisis (eje de pentadas)
	measure BH_Anio = VAR _y = [Anio_Analisis] RETURN CALCULATE ( [Valor_Diario], Variables[Clave] = "BH", Calendario[Anio] = _y )
		formatString: 0.0
		displayFolder: 1 Diario
		lineageTag: 2aca7e45-9ee2-4785-8ab0-27f48863f306

	measure Pentada_Inicio = VAR _y = [Anio_Analisis] RETURN CALCULATE ( MIN ( Calendario[Fecha] ), Calendario[Anio] = _y )
		formatString: dd/mm/yyyy
		displayFolder: 1 Diario
		lineageTag: 60c3140e-eb77-422e-9dd8-988127bf6e58

	measure Pentada_Fin = VAR _y = [Anio_Analisis] RETURN CALCULATE ( MAX ( Calendario[Fecha] ), Calendario[Anio] = _y )
		formatString: dd/mm/yyyy
		displayFolder: 1 Diario
		lineageTag: 0ae99b4a-6602-4470-b6ad-eeeabd7dcdae

	/// Valor de UNA estación en los meses del contexto (solo meses cerrados con ≥ 80 % de días)
	measure _Mes_Est =
			VAR v = [Var_Sel]
			RETURN
			    CALCULATE (
			        SWITCH (
			            v,
			            "PCP", SUM ( Fact_Mensual_met[Precip] ),
			            "ETO", SUM ( Fact_Mensual_met[ETo] ),
			            "ETOD", AVERAGE ( Fact_Mensual_met[ETo_Dia] ),
			            "BH", SUM ( Fact_Mensual_met[BH] ),
			            "RAD", SUM ( Fact_Mensual_met[Rad_MJ] ),
			            "IRR", AVERAGE ( Fact_Mensual_met[Irradiancia] ),
			            "TMED", AVERAGE ( Fact_Mensual_met[Temp_Media] ),
			            "TMAX", MAX ( Fact_Mensual_met[Temp_Max_Abs] ),
			            "TMIN", MIN ( Fact_Mensual_met[Temp_Min_Abs] ),
			            "ICMED", AVERAGE ( Fact_Mensual_met[IC_Media] ),
			            "IC", MAX ( Fact_Mensual_met[IC_Max] ),
			            "ICMIN", MIN ( Fact_Mensual_met[IC_Min_Abs] )
			        ),
			        Fact_Mensual_met[Mes_Valido] = TRUE ()
			    )
		isHidden
		displayFolder: 2 Mensual
		lineageTag: b52c881e-b259-4332-914b-1712e0e10ae7

	/// Promedio entre las estaciones seleccionadas (pool estación-año)
	measure _Grupo_Mes = AVERAGEX ( FILTER ( VALUES ( Estaciones_met[estacionid] ), ( ISFILTERED ( Estaciones_met[Estación] ) || COUNTROWS ( VALUES ( Estaciones_met[estacionid] ) ) <= 1 || CALCULATE ( MAX ( Estaciones_met[Excluir_Agregados] ) ) = 0 ) && NOT ( ISFILTERED ( Estaciones_met[Estación] ) && COUNTROWS ( VALUES ( Estaciones_met[Tipo] ) ) > 1 ) ), [_Mes_Est] )
		isHidden
		displayFolder: 2 Mensual
		lineageTag: e5cbf920-03c5-44d9-9427-daad8fdace38

	/// Variable por mes en el año de análisis; el mes en curso se muestra si es preliminar válido
	measure Valor_Mensual =
			VAR _y = [Anio_Analisis]
			VAR _uno = ( COUNTROWS ( FILTER ( VALUES ( Estaciones_met[estacionid] ), ( ISFILTERED ( Estaciones_met[Estación] ) || COUNTROWS ( VALUES ( Estaciones_met[estacionid] ) ) <= 1 || CALCULATE ( MAX ( Estaciones_met[Excluir_Agregados] ) ) = 0 ) && NOT ( ISFILTERED ( Estaciones_met[Estación] ) && COUNTROWS ( VALUES ( Estaciones_met[Tipo] ) ) > 1 ) ) ) <= 1 || [_Metodo_Directo] || [_Sin_Elegibles] )
			VAR _r =
			    CALCULATE (
			        IF ( _uno, [_Grupo_Mes], [_B_Grupo] ),
			        Fact_Mensual_met[Anio] = _y,
			        TREATAS ( VALUES ( Calendario[Mes_Num] ), Fact_Mensual_met[Mes] )
			    )
			RETURN IF ( [Es_Preliminar] = 1 && [Mostrar_Preliminar] = 0, BLANK (), _r )
		formatString: 0.0
		displayFolder: 2 Mensual
		lineageTag: de047123-f7c9-466a-b069-dd1d99655d87

	/// Media histórica: una estación = promedio de sus años; grupo = promedio de las medias de cada estación (método de anomalías)
	measure Hist_Media =
			VAR _meses = VALUES ( Calendario[Mes_Num] )
			VAR _uno = ( COUNTROWS ( FILTER ( VALUES ( Estaciones_met[estacionid] ), ( ISFILTERED ( Estaciones_met[Estación] ) || COUNTROWS ( VALUES ( Estaciones_met[estacionid] ) ) <= 1 || CALCULATE ( MAX ( Estaciones_met[Excluir_Agregados] ) ) = 0 ) && NOT ( ISFILTERED ( Estaciones_met[Estación] ) && COUNTROWS ( VALUES ( Estaciones_met[Tipo] ) ) > 1 ) ) ) <= 1 || [_Metodo_Directo] || [_Sin_Elegibles] )
			VAR _ini = [Base_Ini]
			VAR _fin = [Base_Fin]
			VAR _anios = FILTER ( ALL ( Fact_Mensual_met[Anio] ), Fact_Mensual_met[Anio] >= _ini && Fact_Mensual_met[Anio] <= _fin )
			// Una estación: serie de sus años
			VAR _t = FILTER ( ADDCOLUMNS ( _anios, "@v", CALCULATE ( [_Grupo_Mes], TREATAS ( _meses, Fact_Mensual_met[Mes] ) ) ), NOT ISBLANK ( [@v] ) )
			// Grupo (método de anomalías): estaciones con ≥ Min_Anios_Base años en el periodo base (cualquier mes); estación × año,
			// media del grupo = promedio de esas medias; serie del grupo = media del grupo + anomalía media de cada año
			VAR _el = FILTER ( FILTER ( VALUES ( Estaciones_met[estacionid] ), ( ISFILTERED ( Estaciones_met[Estación] ) || COUNTROWS ( VALUES ( Estaciones_met[estacionid] ) ) <= 1 || CALCULATE ( MAX ( Estaciones_met[Excluir_Agregados] ) ) = 0 ) && NOT ( ISFILTERED ( Estaciones_met[Estación] ) && COUNTROWS ( VALUES ( Estaciones_met[Tipo] ) ) > 1 ) ), [_Anios_Base_Est] >= [Min_Anios_Base] )
			VAR _sy = FILTER ( ADDCOLUMNS ( CROSSJOIN ( _el, _anios ), "@v", CALCULATE ( [_Mes_Est], TREATAS ( _meses, Fact_Mensual_met[Mes] ) ) ), NOT ISBLANK ( [@v] ) )
			VAR _st = GROUPBY ( _sy, Estaciones_met[estacionid], "@media", AVERAGEX ( CURRENTGROUP (), [@v] ) )
			VAR _G = AVERAGEX ( _st, [@media] )
			// Precipitación: anomalía relativa (valor ÷ media propia), como Jones y Hulme; resto: diferencia
			VAR _rel = [Var_Sel] = "PCP"
			VAR _tB = GROUPBY ( NATURALINNERJOIN ( _sy, _st ), Fact_Mensual_met[Anio], "@a", AVERAGEX ( CURRENTGROUP (), IF ( _rel, DIVIDE ( [@v], [@media] ), [@v] - [@media] ) ) )
			RETURN
			    IF ( _uno, AVERAGEX ( _t, [@v] ), _G )
		formatString: 0.0
		displayFolder: 3 Histórico
		lineageTag: 2247565d-5e9a-4b98-836e-82bd8413179c

	/// Mínimo histórico
	measure Hist_Min =
			VAR _meses = VALUES ( Calendario[Mes_Num] )
			VAR _uno = ( COUNTROWS ( FILTER ( VALUES ( Estaciones_met[estacionid] ), ( ISFILTERED ( Estaciones_met[Estación] ) || COUNTROWS ( VALUES ( Estaciones_met[estacionid] ) ) <= 1 || CALCULATE ( MAX ( Estaciones_met[Excluir_Agregados] ) ) = 0 ) && NOT ( ISFILTERED ( Estaciones_met[Estación] ) && COUNTROWS ( VALUES ( Estaciones_met[Tipo] ) ) > 1 ) ) ) <= 1 || [_Metodo_Directo] || [_Sin_Elegibles] )
			VAR _ini = [Base_Ini]
			VAR _fin = [Base_Fin]
			VAR _anios = FILTER ( ALL ( Fact_Mensual_met[Anio] ), Fact_Mensual_met[Anio] >= _ini && Fact_Mensual_met[Anio] <= _fin )
			// Una estación: serie de sus años
			VAR _t = FILTER ( ADDCOLUMNS ( _anios, "@v", CALCULATE ( [_Grupo_Mes], TREATAS ( _meses, Fact_Mensual_met[Mes] ) ) ), NOT ISBLANK ( [@v] ) )
			// Grupo (método de anomalías): estaciones con ≥ Min_Anios_Base años en el periodo base (cualquier mes); estación × año,
			// media del grupo = promedio de esas medias; serie del grupo = media del grupo + anomalía media de cada año
			VAR _el = FILTER ( FILTER ( VALUES ( Estaciones_met[estacionid] ), ( ISFILTERED ( Estaciones_met[Estación] ) || COUNTROWS ( VALUES ( Estaciones_met[estacionid] ) ) <= 1 || CALCULATE ( MAX ( Estaciones_met[Excluir_Agregados] ) ) = 0 ) && NOT ( ISFILTERED ( Estaciones_met[Estación] ) && COUNTROWS ( VALUES ( Estaciones_met[Tipo] ) ) > 1 ) ), [_Anios_Base_Est] >= [Min_Anios_Base] )
			VAR _sy = FILTER ( ADDCOLUMNS ( CROSSJOIN ( _el, _anios ), "@v", CALCULATE ( [_Mes_Est], TREATAS ( _meses, Fact_Mensual_met[Mes] ) ) ), NOT ISBLANK ( [@v] ) )
			VAR _st = GROUPBY ( _sy, Estaciones_met[estacionid], "@media", AVERAGEX ( CURRENTGROUP (), [@v] ) )
			VAR _G = AVERAGEX ( _st, [@media] )
			// Precipitación: anomalía relativa (valor ÷ media propia), como Jones y Hulme; resto: diferencia
			VAR _rel = [Var_Sel] = "PCP"
			VAR _tB = GROUPBY ( NATURALINNERJOIN ( _sy, _st ), Fact_Mensual_met[Anio], "@a", AVERAGEX ( CURRENTGROUP (), IF ( _rel, DIVIDE ( [@v], [@media] ), [@v] - [@media] ) ) )
			RETURN
			    IF ( _uno, MINX ( _t, [@v] ), MINX ( _tB, IF ( _rel, _G * [@a], _G + [@a] ) ) )
		formatString: 0.0
		displayFolder: 3 Histórico
		lineageTag: 4086619d-57d9-4e9a-a0ee-aea403c9280c

	/// Máximo histórico
	measure Hist_Max =
			VAR _meses = VALUES ( Calendario[Mes_Num] )
			VAR _uno = ( COUNTROWS ( FILTER ( VALUES ( Estaciones_met[estacionid] ), ( ISFILTERED ( Estaciones_met[Estación] ) || COUNTROWS ( VALUES ( Estaciones_met[estacionid] ) ) <= 1 || CALCULATE ( MAX ( Estaciones_met[Excluir_Agregados] ) ) = 0 ) && NOT ( ISFILTERED ( Estaciones_met[Estación] ) && COUNTROWS ( VALUES ( Estaciones_met[Tipo] ) ) > 1 ) ) ) <= 1 || [_Metodo_Directo] || [_Sin_Elegibles] )
			VAR _ini = [Base_Ini]
