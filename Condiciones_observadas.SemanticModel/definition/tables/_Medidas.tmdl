	/// Variable elegida; sin selección, la primera disponible en la página
	measure Var_Sel =
			SELECTEDVALUE (
			    Variables[Clave],
			    MAXX ( TOPN ( 1, VALUES ( Variables ), Variables[Orden], ASC ), Variables[Clave] )
			)
		displayFolder: 0 Contexto
		lineageTag: 72d5c5be-e74b-4d2b-a922-4e3ddfae3f80

	measure Var_Nombre =
			VAR _v = [Var_Sel]
			RETURN MAXX ( FILTER ( ALL ( Variables ), Variables[Clave] = _v ), Variables[Variable] )
		displayFolder: 0 Contexto
		lineageTag: d15f095b-65d7-467f-b000-bb371f36ac15

	measure Var_Unidad =
			VAR _v = [Var_Sel]
			RETURN MAXX ( FILTER ( ALL ( Variables ), Variables[Clave] = _v ), Variables[Unidad] )
		displayFolder: 0 Contexto
		lineageTag: bf4feace-7f92-475a-832f-36cafe92d742

	/// Suma (acumulativas) · Promedio · Máximo · Mínimo
