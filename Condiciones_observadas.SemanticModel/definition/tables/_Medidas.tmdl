			RETURN
			    IF (
			        NOT ISBLANK ( _y ),
			        CALCULATE ( [_Grupo_Mes], Fact_Mensual_met[Anio] = _y, TREATAS ( VALUES ( Calendario[Mes_Num] ), Fact_Mensual_met[Mes] ) )
			    )
