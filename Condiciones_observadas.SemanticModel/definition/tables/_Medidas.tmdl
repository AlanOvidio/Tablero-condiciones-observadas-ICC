	/// Años con dato en el periodo base
	measure Hist_N_Anios =
			VAR _meses = VALUES ( Calendario[Mes_Num] )
			VAR _ini = [Base_Ini]
			VAR _fin = [Base_Fin]
			VAR _t =
			    FILTER (
