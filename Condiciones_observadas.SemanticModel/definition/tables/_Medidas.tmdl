	measure Anomalia = IF ( NOT ISBLANK ( [Valor_Mensual] ), [Valor_Mensual] - [Hist_Media] )
		formatString: +0.0;-0.0;0.0
		displayFolder: 4 Anomalías
		lineageTag: 69025a5d-a7f9-4242-ac26-f0105f9b5dfb

	measure Anomalia_Pct = IF ( NOT ISBLANK ( [Valor_Mensual] ), DIVIDE ( [Valor_Mensual] - [Hist_Media], [Hist_Media] ) )
		formatString: +0%;-0%;0%
		displayFolder: 4 Anomalías
		lineageTag: 0231a577-b84f-41be-acc9-457c6d93a632

	/// Umbrales por variable en la tabla Variables (T: ±0.5/±1 °C; Pp: ±15/±40 %, como script_nuevo.R)
	measure Anomalia_Categoria =
			VAR _v = [Var_Sel]
			VAR _tipo = MAXX ( FILTER ( ALL ( Variables ), Variables[Clave] = _v ), Variables[Anom_Tipo] )
			VAR _u1 = MAXX ( FILTER ( ALL ( Variables ), Variables[Clave] = _v ), Variables[Umbral1] )
			VAR _u2 = MAXX ( FILTER ( ALL ( Variables ), Variables[Clave] = _v ), Variables[Umbral2] )
			VAR _a = IF ( _tipo = "pct", [Anomalia_Pct] * 100, [Anomalia] )
			RETURN
			    IF (
			        NOT ISBLANK ( _a ),
			        SWITCH (
			            TRUE (),
			            _a > _u2, "Muy por encima",
			            _a > _u1, "Por encima",
			            _a < -_u2, "Muy por debajo",
			            _a < -_u1, "Por debajo",
			            "Normal"
			        )
			    )
		displayFolder: 4 Anomalías
		lineageTag: 49719f33-296a-453d-a9f2-6d7105e85007

	measure Anomalia_Color =
			SWITCH (
			    [Anomalia_Categoria],
			    "Muy por encima", "#d73027",
			    "Por encima", "#fc8d59",
			    "Normal", "#91bfdb",
			    "Por debajo", "#4575b4",
			    "Muy por debajo", "#313695"
			)
		displayFolder: 4 Anomalías
		lineageTag: 7b33e22e-2443-4876-80b2-9ee4829716f0

	/// Acumulado mensual del año de análisis (civil o hidrológico). Suma por estación y luego promedio.
	measure Acum_Mensual =
			VAR _modo = SELECTEDVALUE ( Meses_Acum[Modo], "Año civil (ene–dic)" )
			VAR _p = MAX ( Meses_Acum[Pos] )
			VAR _y = [Anio_Analisis]
			VAR _pares =
			    SELECTCOLUMNS (
			        FILTER ( ALL ( Meses_Acum ), Meses_Acum[Modo] = _modo && Meses_Acum[Pos] <= _p ),
			        "Anio", _y - Meses_Acum[Desfase_Anio],
			        "Mes", Meses_Acum[Mes_Num]
			    )
			VAR _ultimo = MAXX ( _pares, [Anio] * 100 + [Mes] )
			RETURN
			    IF (
			        [Var_Regla] = "Suma" && _ultimo <= [Ultimo_Mes_Completo],
			        CALCULATE ( [_Grupo_Mes], TREATAS ( _pares, Fact_Mensual_met[Anio], Fact_Mensual_met[Mes] ) )
			    )
		formatString: 0.0
		displayFolder: 5 Acumulados
		lineageTag: 762d6137-89f8-4a5d-bd51-c2f7cd5f12ab

	/// Igual que Acum_Mensual para cada año adicional (Anios_Comparacion en la leyenda)
	measure Acum_Mensual_Anio_Comp =
			VAR _modo = SELECTEDVALUE ( Meses_Acum[Modo], "Año civil (ene–dic)" )
			VAR _p = MAX ( Meses_Acum[Pos] )
			VAR _y = SELECTEDVALUE ( Anios_Comparacion[Año] )
			VAR _pares =
			    SELECTCOLUMNS (
			        FILTER ( ALL ( Meses_Acum ), Meses_Acum[Modo] = _modo && Meses_Acum[Pos] <= _p ),
			        "Anio", _y - Meses_Acum[Desfase_Anio],
			        "Mes", Meses_Acum[Mes_Num]
			    )
			VAR _ultimo = MAXX ( _pares, [Anio] * 100 + [Mes] )
			RETURN
			    IF (
			        [Var_Regla] = "Suma" && _ultimo <= [Ultimo_Mes_Completo],
			        CALCULATE ( [_Grupo_Mes], TREATAS ( _pares, Fact_Mensual_met[Anio], Fact_Mensual_met[Mes] ) )
			    )
		formatString: 0.0
		displayFolder: 5 Acumulados
		lineageTag: 90bf5ab0-b4f6-4329-934b-bb93abc95611

	/// Suma acumulada de Hist_Media (mismo criterio que los scripts R)
	measure Hist_Acum_Media =
			VAR _modo = SELECTEDVALUE ( Meses_Acum[Modo], "Año civil (ene–dic)" )
			VAR _p = MAX ( Meses_Acum[Pos] )
			RETURN
			    IF (
			        [Var_Regla] = "Suma",
			        SUMX (
			            FILTER ( ALL ( Meses_Acum ), Meses_Acum[Modo] = _modo && Meses_Acum[Pos] <= _p ),
			            VAR _m = Meses_Acum[Mes_Num]
			            RETURN CALCULATE ( [Hist_Media], REMOVEFILTERS ( Meses_Acum ), Calendario[Mes_Num] = _m )
			        )
			    )
		formatString: 0.0
		displayFolder: 5 Acumulados
		lineageTag: bc0a8d02-1caf-4508-b0f7-24ce2ecce4d7

