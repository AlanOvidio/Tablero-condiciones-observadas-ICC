	measure Titulo_Variable = [Var_Nombre] & " (" & [Var_Unidad] & ")"
		displayFolder: 7 Textos
		lineageTag: 24e1a364-9232-4619-aeec-26b6ed776de7

	measure Nota_Fuente =
			"Fuente: Red Meteorológica ICC  |  Periodo base: " & [Base_Ini] & "–" & [Base_Fin] &
			"  |  n histórico: " & [Hist_N_Anios] & " años  |  Datos al " & FORMAT ( [Ultima_Fecha], "dd/mm/yyyy" )
		displayFolder: 7 Textos
		lineageTag: 4dcc0385-b25b-410a-916f-b56ddf44ef5f

	column Column
		isHidden
		formatString: 0
		lineageTag: 1271d80f-7b29-4662-9cf7-63fe3b384c88
		summarizeBy: none
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition _Medidas = calculated
		mode: import
		source = Row("Column", BLANK())

