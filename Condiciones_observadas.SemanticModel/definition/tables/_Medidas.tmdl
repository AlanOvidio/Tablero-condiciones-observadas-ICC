			        [Var_Regla] = "Suma" && _y * 100 + _m <= [Ultimo_Mes_Completo],
			        CALCULATE ( [_Grupo_Mes], Fact_Mensual_met[Anio] = _y, Fact_Mensual_met[Mes] <= _m )
