	measure Titulo_Comp_Nota = IF ( SELECTEDVALUE ( Vista_Comp[Vista], "Mensual" ) = "Acumulado mensual" && NOT [Comp_Acum], "  |  el acumulado solo aplica a variables acumulativas" )
		isHidden
