	/// Años con dato en el periodo histórico
	measure Hist_N_Anios =
			VAR _meses = VALUES ( Calendario[Mes_Num] )
			VAR _ini = [Base_Ini]
			VAR _fin = [Base_Fin]
			VAR _t =
			    FILTER (
			        ADDCOLUMNS (
			            FILTER ( ALL ( Fact_Mensual_met[Anio] ), Fact_Mensual_met[Anio] >= _ini && Fact_Mensual_met[Anio] <= _fin ),
			            "@v", CALCULATE ( [_Grupo_Mes], TREATAS ( _meses, Fact_Mensual_met[Mes] ) )
			        ),
			        NOT ISBLANK ( [@v] )
			    )
			RETURN
			    COUNTROWS ( _t )
		formatString: 0.0
		displayFolder: 3 Histórico
		lineageTag: 6dfc544f-ade0-4812-9e20-0ae5dede9e35

	/// Año real con datos de la selección (para la leyenda y el subtítulo)
	measure Hist_Anio_Ini =
			VAR _ini = [Base_Ini]
			VAR _fin = [Base_Fin]
			RETURN
			    CALCULATE (
			        MIN ( Fact_Mensual_met[Anio] ),
			        Fact_Mensual_met[Mes_Valido] = TRUE (),
			        Fact_Mensual_met[Anio] >= _ini,
			        Fact_Mensual_met[Anio] <= _fin
			    )
		formatString: 0
		displayFolder: 3 Histórico
		lineageTag: 75937a6d-8304-4294-a3bd-adae3438388c

	/// Año real con datos de la selección (para la leyenda y el subtítulo)
	measure Hist_Anio_Fin =
			VAR _ini = [Base_Ini]
			VAR _fin = [Base_Fin]
			RETURN
			    CALCULATE (
			        MAX ( Fact_Mensual_met[Anio] ),
			        Fact_Mensual_met[Mes_Valido] = TRUE (),
			        Fact_Mensual_met[Anio] >= _ini,
			        Fact_Mensual_met[Anio] <= _fin
			    )
		formatString: 0
		displayFolder: 3 Histórico
		lineageTag: eb091ccb-4301-4281-bb79-7c65b9c529ea

	/// Año de análisis − media histórica
	measure Anomalia = IF ( NOT ISBLANK ( [Valor_Mensual] ) && NOT ISBLANK ( [Hist_Media] ), [Valor_Mensual] - [Hist_Media] )
		formatString: +0.0;-0.0;0.0
		displayFolder: 4 Anomalías
		lineageTag: 1ceb62e7-5fad-4fcb-b3f7-c4dda23dba07

	measure Anomalia_Pct = IF ( NOT ISBLANK ( [Anomalia] ), DIVIDE ( [Anomalia], ABS ( [Hist_Media] ) ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4 Anomalías
		lineageTag: 1168abc2-f11c-4a77-b74a-1835df0e7061

	/// Texto como en los scripts R ('|' = salto de línea)
	measure Anomalia_Etiqueta =
			VAR _a = [Anomalia]
			VAR _v = [Var_Sel]
			VAR _tipo = MAXX ( FILTER ( ALL ( Variables ), Variables[Clave] = _v ), Variables[Anom_Tipo] )
			VAR _dec = MAXX ( FILTER ( ALL ( Variables ), Variables[Clave] = _v ), Variables[Decimales] )
			RETURN
			    IF (
			        NOT ISBLANK ( _a ),
			        FORMAT ( _a, IF ( _dec > 0, "+0.0;-0.0;0", "+0;-0;0" ) ) & " " & [Var_Unidad]
			            & IF ( _tipo = "pct", "|(" & FORMAT ( [Anomalia_Pct], "+0%;-0%;0%" ) & ")" )
			    )
		displayFolder: 4 Anomalías
		lineageTag: 7d248674-2282-40e5-aba7-37edfa3dc871

	/// Lluvia y balance: positivo azul; temperatura, ETo y radiación: positivo rojo
	measure Anomalia_Color =
			VAR _a = [Anomalia]
			VAR _v = [Var_Sel]
			VAR _azul = MAXX ( FILTER ( ALL ( Variables ), Variables[Clave] = _v ), Variables[Positivo_Azul] ) = 1
			RETURN IF ( NOT ISBLANK ( _a ), IF ( ( _a >= 0 ) = _azul, "#4575b4", "#d73027" ) )
		isHidden
		displayFolder: 4 Anomalías
		lineageTag: 590211d8-bc06-44eb-a212-92729da292b6

	/// Año adicional n.º 1 de la selección
	measure Anio_Comp_1 =
			VAR _t = VALUES ( Anios_Comparacion[Año] )
			RETURN
			    IF (
			        ISFILTERED ( Anios_Comparacion[Año] ) && COUNTROWS ( _t ) >= 1,
			        MAXX ( TOPN ( 1, _t, Anios_Comparacion[Año], ASC ), Anios_Comparacion[Año] )
			    )
		formatString: 0
		displayFolder: 5 Años adicionales
		lineageTag: d5012791-e2f8-4dc1-800d-a397baedfba8

	measure Anio_Comp_1_Txt = FORMAT ( [Anio_Comp_1], "0" )
		isHidden
		displayFolder: 5 Años adicionales
		lineageTag: 42b8fa9c-8fb5-4e1e-8a87-ecd367a0d969

	/// Mismas estaciones que la selección
	measure Valor_Comp_1 =
			VAR _y = [Anio_Comp_1]
			RETURN
			    IF (
			        NOT ISBLANK ( _y ),
			        CALCULATE ( [_Grupo_Mes], Fact_Mensual_met[Anio] = _y, TREATAS ( VALUES ( Calendario[Mes_Num] ), Fact_Mensual_met[Mes] ) )
			    )
		formatString: 0.0
		displayFolder: 5 Años adicionales
		lineageTag: 536e9952-6054-45d4-9760-9ef64cd6ef85

	measure Acum_Comp_1 =
			VAR _modo = SELECTEDVALUE ( Meses_Acum[Modo], "Año calendario (ene–dic)" )
			VAR _p = MAX ( Meses_Acum[Pos] )
			VAR _y = [Anio_Comp_1]
			VAR _pares =
			    SELECTCOLUMNS (
			        FILTER ( ALL ( Meses_Acum ), Meses_Acum[Modo] = _modo && Meses_Acum[Pos] <= _p ),
			        "Anio", _y - Meses_Acum[Desfase_Anio],
			        "Mes", Meses_Acum[Mes_Num]
			    )
			VAR _ultimo = MAXX ( _pares, [Anio] * 100 + [Mes] )
			RETURN
			    IF (
			        NOT ISBLANK ( _y ) && [Var_Regla] = "Suma" && _ultimo <= [Ultimo_Mes_Completo],
			        CALCULATE ( [_Grupo_Mes], TREATAS ( _pares, Fact_Mensual_met[Anio], Fact_Mensual_met[Mes] ) )
			    )
		formatString: 0.0
		displayFolder: 5 Años adicionales
		lineageTag: 730f8eac-6071-442c-8fa1-d5cdfb784ab6

