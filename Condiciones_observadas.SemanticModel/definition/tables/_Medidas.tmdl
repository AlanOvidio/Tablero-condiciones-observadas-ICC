	/// Acumulado desde el 1 de enero hasta la fecha del contexto
	measure Acum_Diario =
			VAR _fin = MAX ( Calendario[Fecha] )
			VAR _ini = DATE ( YEAR ( _fin ), 1, 1 )
			RETURN
			    IF (
			        [Var_Regla] = "Suma" && _fin <= [Ultima_Fecha],
			        AVERAGEX (
			            VALUES ( Estaciones_met[estacionid] ),
			            CALCULATE ( [_Dia_Est], REMOVEFILTERS ( Calendario ), DATESBETWEEN ( Calendario[Fecha], _ini, _fin ) )
			        )
			    )
		formatString: 0.0
		displayFolder: 8 Páginas heredadas
		lineageTag: 2ec32d3b-e5f7-4b08-8d5f-f37271b75d1b

	/// Color del mapa en 5 clases relativas entre las estaciones visibles
	measure Color_Mapa =
			VAR _v = [Valor_Diario]
			VAR _sel = [Var_Sel]
			VAR _g = MAXX ( FILTER ( ALL ( Variables ), Variables[Clave] = _sel ), Variables[Grupo] )
			VAR _t = ADDCOLUMNS ( ALLSELECTED ( Estaciones_met[estacionid] ), "@v", [Valor_Diario] )
			VAR _mn = MINX ( _t, [@v] )
			VAR _mx = MAXX ( _t, [@v] )
			VAR _k = IF ( _mx = _mn, 2, INT ( MIN ( DIVIDE ( _v - _mn, _mx - _mn ), 0.999 ) * 5 ) )
			RETURN
			    IF (
			        NOT ISBLANK ( _v ),
			        SWITCH (
			            _g,
			            "Agua", SWITCH ( _k, 0, "#DEEBF7", 1, "#9ECAE1", 2, "#4292C6", 3, "#2171B5", "#08306B" ),
			            "Radiación", SWITCH ( _k, 0, "#FEE6CE", 1, "#FDAE6B", 2, "#F16913", 3, "#D94801", "#7F2704" ),
			            SWITCH ( _k, 0, "#FEE0D2", 1, "#FC9272", 2, "#EF3B2C", 3, "#CB181D", "#67000D" )
			        )
			    )
		isHidden
		displayFolder: 8 Páginas heredadas
		lineageTag: a0df4b3c-1026-4416-9dbc-6088bf696c5c

	/// Radiación media diaria (MJ/m²) de la pentada en el año de análisis
	measure Rad_Media_Pentada =
			VAR _y = [Anio_Analisis]
			RETURN
			    AVERAGEX (
			        VALUES ( Estaciones_met[estacionid] ),
			        CALCULATE ( AVERAGE ( Fact_Diaria_met[Rad_MJ] ), Calendario[Anio] = _y )
			    )
		formatString: 0.0
		displayFolder: 8 Páginas heredadas
		lineageTag: 2add8ed7-cae1-4f24-b955-4e4e885ebb0a

	measure Banda_Rad_Suboptima = SELECTEDVALUE ( Umbral_Rad_Sub[MJ], 12 )
		formatString: 0
		displayFolder: 8 Páginas heredadas
		lineageTag: 0f55da39-9a6a-4464-a108-7cf0f642ab5d

	measure Banda_Rad_Aceptable = SELECTEDVALUE ( Umbral_Rad_Opt[MJ], 20 ) - [Banda_Rad_Suboptima]
		formatString: 0
		displayFolder: 8 Páginas heredadas
		lineageTag: 263512b7-dca9-4219-8a31-7680c12c2639

	measure Banda_Rad_Optima = 10
		formatString: 0
		displayFolder: 8 Páginas heredadas
		lineageTag: d1684953-d125-436c-a8b1-72fe600777c9

	/// Sensación térmica máxima del último día con datos
	measure IC_Ultimo_Dia = VAR _u = [Ultima_Fecha] RETURN CALCULATE ( [Valor_Diario], Variables[Clave] = "IC", REMOVEFILTERS ( Calendario ), Calendario[Fecha] = _u )
		formatString: 0.0
		displayFolder: 8 Páginas heredadas
		lineageTag: 5340313d-4eeb-4f37-a031-a9c3a8749d55

	measure IC_Ultimos_7 =
			VAR _u = [Ultima_Fecha]
			VAR _d = MAX ( Calendario[Fecha] )
			RETURN IF ( _d > _u - 7 && _d <= _u, CALCULATE ( [Valor_Diario], Variables[Clave] = "IC" ) )
		formatString: 0.0
		displayFolder: 8 Páginas heredadas
		lineageTag: 35913520-af53-4dba-9755-52d3a10ce63c

	/// Variable en las fechas del Periodo A
	measure Valor_Periodo_A =
			AVERAGEX (
			    VALUES ( Estaciones_met[estacionid] ),
			    CALCULATE ( [_Dia_Est], REMOVEFILTERS ( Calendario ), TREATAS ( VALUES ( Periodo_A[Fecha] ), Fact_Diaria_met[Fecha] ) )
			)
		formatString: 0.0
		displayFolder: 8 Páginas heredadas
		lineageTag: 4e1a2287-e96f-4343-bb6d-d3da7fa66424

	/// Acumulado desde el inicio del Periodo A (eje: día del periodo)
	measure Acum_Periodo_A =
			VAR _ini = MIN ( Periodo_A[Fecha] )
			VAR _fin = MAX ( Periodo_A[Fecha] )
			VAR _f = _ini + MAX ( Dias_Periodo[Día] ) - 1
			RETURN
			    IF (
			        [Var_Regla] = "Suma" && _f <= _fin && _f <= [Ultima_Fecha],
			        AVERAGEX (
			            VALUES ( Estaciones_met[estacionid] ),
			            CALCULATE ( [_Dia_Est], REMOVEFILTERS ( Calendario ), DATESBETWEEN ( Calendario[Fecha], _ini, _f ) )
			        )
			    )
		formatString: 0.0
		displayFolder: 8 Páginas heredadas
		lineageTag: a500310d-e791-4058-8013-32754a50fa5d

	/// Variable en las fechas del Periodo B
	measure Valor_Periodo_B =
			AVERAGEX (
			    VALUES ( Estaciones_met[estacionid] ),
			    CALCULATE ( [_Dia_Est], REMOVEFILTERS ( Calendario ), TREATAS ( VALUES ( Periodo_B[Fecha] ), Fact_Diaria_met[Fecha] ) )
			)
		formatString: 0.0
		displayFolder: 8 Páginas heredadas
		lineageTag: bfa7813c-6aa3-443e-808b-6518da05c913

	/// Acumulado desde el inicio del Periodo B (eje: día del periodo)
	measure Acum_Periodo_B =
			VAR _ini = MIN ( Periodo_B[Fecha] )
			VAR _fin = MAX ( Periodo_B[Fecha] )
			VAR _f = _ini + MAX ( Dias_Periodo[Día] ) - 1
			RETURN
			    IF (
			        [Var_Regla] = "Suma" && _f <= _fin && _f <= [Ultima_Fecha],
			        AVERAGEX (
			            VALUES ( Estaciones_met[estacionid] ),
			            CALCULATE ( [_Dia_Est], REMOVEFILTERS ( Calendario ), DATESBETWEEN ( Calendario[Fecha], _ini, _f ) )
			        )
			    )
		formatString: 0.0
		displayFolder: 8 Páginas heredadas
		lineageTag: 29436e46-b5e5-4d50-8fb4-3dd4aea9d6f5

	/// Filtro del segmentador de periodo histórico: solo años anteriores al de análisis
	measure Base_Disponible = IF ( MAX ( Anios_Base[Año] ) < [Anio_Analisis], 1 )
		formatString: 0
		isHidden
		displayFolder: 0 Contexto
		lineageTag: 562c20e7-7c90-4b1a-b44a-bfca4b89df31

	/// Vista acumulada activa y variable acumulativa (Suma)
	measure Comp_Acum = SELECTEDVALUE ( Vista_Comp[Vista], "Mensual" ) = "Acumulado mensual" && [Var_Regla] = "Suma"
		isHidden
		displayFolder: 8 Páginas heredadas
		lineageTag: 6ff33a02-add0-47a5-bbc8-be680a9d0f67

	/// Comparativas mensuales: valor mensual o acumulado de enero al mes, según la vista
	measure Comp_Valor = IF ( [Comp_Acum], [Acum_Mes_Por_Anio], [Mensual_Por_Anio] )
		formatString: 0.0
		displayFolder: 8 Páginas heredadas
		lineageTag: 3e9ce014-ce58-4d55-bb53-81362ea63fa9

	/// Comparativas mensuales por estación: el valor en el año de análisis
	measure Comp_Valor_Anio =
			VAR _y = [Anio_Analisis]
			RETURN CALCULATE ( [Comp_Valor], Calendario[Anio] = _y )
		formatString: 0.0
		displayFolder: 8 Páginas heredadas
		lineageTag: 431d0df9-3f09-474e-b5d5-c2484670339b

	measure Titulo_Comp = [Var_Nombre] & IF ( [Comp_Acum], " acumulada", " mensual" ) & " (" & [Var_Unidad] & ")"
		isHidden
