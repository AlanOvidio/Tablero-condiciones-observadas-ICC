/// Lecturas diarias de una estación (endpoint getlecturasdia)
expression fxLecturasEstacion_met_diario =
		(estacionId as number, RangeStart as datetime, RangeEnd as datetime) =>
		let
		    fechaini = DateTime.ToText(RangeStart, "yyyy-MM-dd HH:mm"),
		    fechafin = DateTime.ToText(RangeEnd, "yyyy-MM-dd HH:mm"),
		    Origen = Json.Document(
		        Web.Contents(
		            "https://redmet.icc.org.gt/ws/getlecturasdia",
		            [
		                Query = [
		                    fechaini   = fechaini,
		                    fechafin   = fechafin,
		                    estacionid = Number.ToText(estacionId)
		                ],
		                Timeout = #duration(0, 0, 5, 0)
		            ]
		        )
		    ),
		    Lecturas = try Origen[data] otherwise {}
		in
		    Lecturas
	lineageTag: 1d78ec3f-b339-4462-be8c-943531303cd3

	annotation PBI_ResultType = Function

/// Control de calidad: valores diarios fuera de rango → nulo. Límites editables en Limites.
expression fxLimpiarDiario =
		(t as table) as table =>
		let
		    // {mínimo, máximo} por columna (valores diarios)
		    Limites = [
		        Temp_Media = {-5, 50}, Temp_Min = {-5, 50}, Temp_Max = {-5, 50},
		        Precip_Total = {0, 400},
		        ETO_Total = {0.01, 15},           // 0 en el día = sin dato
		        Rad_Total = {1, 44444},          // Σ W/m² de 96 lecturas ≈ 40 MJ/m²·día; 0 en el día = sin dato
		        IC_Media = {-5, 70}, IC_Min = {-5, 70}, IC_Max = {-5, 70}
		    ],
		    Columnas = List.Intersect({Record.FieldNames(Limites), Table.ColumnNames(t)}),
		    // Día con temperatura media, mínima y máxima en 0 a la vez = sensor sin dato
		    Temps = List.Intersect({{"Temp_Media", "Temp_Min", "Temp_Max"}, Table.ColumnNames(t)}),
		    MarcaT0 = Table.AddColumn(t, "_T0", (r) => List.Count(Temps) = 3 and List.AllTrue(List.Transform(Temps, (c) => Record.Field(r, c) = 0))),
		    SinT0 = List.Accumulate(
		        List.Intersect({{"Temp_Media", "Temp_Min", "Temp_Max", "IC_Media", "IC_Min", "IC_Max"}, Table.ColumnNames(t)}), MarcaT0,
		        (tb, c) => Table.ReplaceValue(tb, each Record.Field(_, c), each if [_T0] then null else Record.Field(_, c), Replacer.ReplaceValue, {c})),
		    // Estaciones que solo miden precipitación: las demás variables quedan nulas
		    SoloP = if Table.HasColumns(SinT0, "Solo_Precip") then List.Accumulate(
		        List.Intersect({{"Temp_Media", "Temp_Min", "Temp_Max", "Rad_Total", "ETO_Total", "IC_Media", "IC_Min", "IC_Max"}, Table.ColumnNames(t)}), SinT0,
		        (tb, c) => Table.ReplaceValue(tb, each Record.Field(_, c), each if [Solo_Precip] = true then null else Record.Field(_, c), Replacer.ReplaceValue, {c}))
		        else SinT0,
		    Base = Table.RemoveColumns(SoloP, List.Intersect({{"_T0", "Solo_Precip"}, Table.ColumnNames(SoloP)})),
		    Limpia = Table.TransformColumns(
		        Base,
		        List.Transform(Columnas, (c) => {c, (v) =>
		            if v = null or v < Record.Field(Limites, c){0} or v > Record.Field(Limites, c){1} then null else v,
		            type nullable number})
		    )
		in
		    Limpia
	lineageTag: 2b8d1f90-ae2f-4e77-9f87-3c3cb7bc5d09

	annotation PBI_ResultType = Function

