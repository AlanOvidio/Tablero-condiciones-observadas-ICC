# ── Power BI Project: archivos locales que NO deben versionarse ──
# Caché de datos importados (decenas de MB; se regenera al actualizar)
**/.pbi/cache.abf
# Configuración local de cada usuario/equipo
**/.pbi/localSettings.json

# ── Respaldos manuales previos a usar Git (Git ya guarda el historial) ──
_respaldo*/

# ── Copias de conflicto de OneDrive (nombre de equipo como sufijo) ──
*-AlanOvidio.*
*-AlanOvidio/

# ── Sistema / herramientas ──
Thumbs.db
desktop.ini
.DS_Store
__pycache__/
*.pyc

**/.pbi/unappliedChanges.json

# ── Scripts locales de figuras en R (referencia; no forman parte del repositorio) ──
otros_archivos/*.R
.Renviron
.Rhistory
.RData
.Rproj.user/
# Salidas de gráficas de los scripts R
graficas*/

# ── Índices espaciales de ArcGIS (se regeneran; no los usa sf) ──
*.sbn
*.sbx

# Archivos de apoyo generados en las sesiones con Claude
Claude outputs/
