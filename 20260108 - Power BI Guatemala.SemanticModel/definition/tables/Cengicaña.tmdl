table Cengicaña
	lineageTag: 486893f3-4c12-4a79-9523-a8b81fc6ec58

	measure 'Total acumulado de Precipitacion Acumulada Cengicaña en Mes' =
			
			CALCULATE(
				SUM('Cengicaña'[Precipitacion Acumulada Cengicaña]),
				FILTER(
					CALCULATETABLE(
						SUMMARIZE('Cengicaña', 'Cengicaña'[Día].[NroMes], 'Cengicaña'[Día].[Mes]),
						ALLSELECTED('Cengicaña')
					),
					ISONORAFTER(
						'Cengicaña'[Día].[NroMes], MAX('Cengicaña'[Día].[NroMes]), DESC,
						'Cengicaña'[Día].[Mes], MAX('Cengicaña'[Día].[Mes]), DESC
					)
				)
			)
		lineageTag: 422b591f-c2f4-41c6-a115-79aadc95056c

		extendedProperty MeasureTemplate =
