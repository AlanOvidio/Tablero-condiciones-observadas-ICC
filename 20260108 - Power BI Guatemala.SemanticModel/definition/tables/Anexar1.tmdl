	measure 'Total acumulado de Precipitacion Acumulada  en Mes' =
			
			CALCULATE(
				SUM('Anexar1'[Precipitación Acumulada ]),
				FILTER(
					CALCULATETABLE(
						SUMMARIZE('Anexar1', 'Anexar1'[Días].[NroMes], 'Anexar1'[Días].[Mes]),
						ALLSELECTED('Anexar1')
					),
					ISONORAFTER(
						'Anexar1'[Días].[NroMes], MAX('Anexar1'[Días].[NroMes]), DESC,
						'Anexar1'[Días].[Mes], MAX('Anexar1'[Días].[Mes]), DESC
					)
				)
			)
		lineageTag: da9820ee-c988-4ed7-b5c4-5a5f2f623a50

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "RunningTotal"
				}

