	column 'Índice de calor' = ```
			
			ROUND(
			    IF(
			        (
			            Anexar1[Humedad Máxima] < 13 &&
			            Anexar1[Temperatura Máxima] >= 26.7 &&
			            Anexar1[Temperatura Máxima] <= 44.4
			        ), 
			        Anexar1[Temperatura Máxima] * 1.61139411 + 
			        Anexar1[Humedad Máxima] * 2.33854883889 + 
			        Anexar1[Temperatura Máxima] * Anexar1[Humedad Máxima] * (-0.14611605) + 
			        POWER(Anexar1[Temperatura Máxima], 2) * (-0.012308094) + 
			        POWER(Anexar1[Humedad Máxima], 2) * (-0.0164248277778) + 
			        POWER(Anexar1[Temperatura Máxima], 2) * Anexar1[Humedad Máxima] * 0.002211732 + 
			        Anexar1[Temperatura Máxima] * POWER(Anexar1[Humedad Máxima], 2) * 0.00072546 + 
			        POWER(Anexar1[Temperatura Máxima], 2) * POWER(Anexar1[Humedad Máxima], 2) * (-0.000003582) - 
			        8.78469475556 - 
			        (((13 - Anexar1[Humedad Máxima]) / 4) * SQRT((17 - ABS(Anexar1[Temperatura Máxima] - 35)) / 17)), 
			        IF(
			            (
			                Anexar1[Humedad Máxima] > 85 &&
			                Anexar1[Temperatura Máxima] >= 26.7 &&
			                Anexar1[Temperatura Máxima] <= 30.6
			            ), 
			            Anexar1[Temperatura Máxima] * 1.61139411 + 
			            Anexar1[Humedad Máxima] * 2.33854883889 + 
			            Anexar1[Temperatura Máxima] * Anexar1[Humedad Máxima] * (-0.14611605) + 
			            POWER(Anexar1[Temperatura Máxima], 2) * (-0.012308094) + 
			            POWER(Anexar1[Humedad Máxima], 2) * (-0.0164248277778) + 
			            POWER(Anexar1[Temperatura Máxima], 2) * Anexar1[Humedad Máxima] * 0.002211732 + 
			            Anexar1[Temperatura Máxima] * POWER(Anexar1[Humedad Máxima], 2) * 0.00072546 + 
			            POWER(Anexar1[Temperatura Máxima], 2) * POWER(Anexar1[Humedad Máxima], 2) * (-0.000003582) - 
			            8.78469475556 + 
			            (((Anexar1[Humedad Máxima] - 85) / 10) * ((30.6 - Anexar1[Temperatura Máxima]) / 5)),
			            Anexar1[Temperatura Máxima] * 1.61139411 + 
			            Anexar1[Humedad Máxima] * 2.33854883889 + 
			            Anexar1[Temperatura Máxima] * Anexar1[Humedad Máxima] * (-0.14611605) + 
			            POWER(Anexar1[Temperatura Máxima], 2) * (-0.012308094) + 
			            POWER(Anexar1[Humedad Máxima], 2) * (-0.0164248277778) + 
			            POWER(Anexar1[Temperatura Máxima], 2) * Anexar1[Humedad Máxima] * 0.002211732 + 
			            Anexar1[Temperatura Máxima] * POWER(Anexar1[Humedad Máxima], 2) * 0.00072546 + 
			            POWER(Anexar1[Temperatura Máxima], 2) * POWER(Anexar1[Humedad Máxima], 2) * (-0.000003582) - 
			            8.78469475556
			        )
			    ), 
			    1
			)
			
			
			```
		lineageTag: 662fe211-4147-4a62-935b-5ba963598044
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

