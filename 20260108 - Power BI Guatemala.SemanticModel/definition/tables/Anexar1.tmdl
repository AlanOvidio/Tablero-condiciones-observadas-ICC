	measure 'Total acumulado de Precipitacion Periodo A en Día Juliano' =
			
			CALCULATE(
				[Precipitacion Periodo A],
				FILTER(
					ALLSELECTED('Anexar1'[Día Juliano]),
					ISONORAFTER('Anexar1'[Día Juliano], MAX('Anexar1'[Día Juliano]), DESC)
				)
			)
		lineageTag: ba0524b8-9ed8-4403-8776-5850eec3ff02

